{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acqivo.local/schemas/sandbox_event.schema.json",
  "title": "Acqivo Stage 2 Sandbox Operational Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "occurred_at",
    "company_slug",
    "primary_classification",
    "workflow_id",
    "entity_type",
    "entity_id",
    "event_type",
    "agent_type",
    "action",
    "risk_level",
    "state_before",
    "state_after",
    "result",
    "external_side_effect",
    "evidence_refs",
    "autonomy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "company_slug": {
      "const": "acqivo"
    },
    "primary_classification": {
      "enum": [
        "acquisition",
        "customer_onboarding",
        "missed_inquiry_recovery",
        "estimate_followup",
        "stale_lead_reactivation",
        "approval_queue",
        "failure_recovery"
      ]
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "enum": [
        "prospect",
        "customer",
        "lead",
        "message",
        "approval",
        "payment",
        "integration",
        "task",
        "workflow_run",
        "customer_account",
        "estimate",
        "lead_batch",
        "integration_operation"
      ]
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "input_received",
        "decision_produced",
        "transition_attempted",
        "transition_completed",
        "approval_requested",
        "approval_resolved",
        "integration_attempted",
        "failure_detected",
        "recovery_performed",
        "terminal_outcome"
      ]
    },
    "agent_type": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "enum": [
        "GREEN",
        "YELLOW",
        "RED"
      ]
    },
    "state_before": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "enum": [
        "observed",
        "drafted",
        "executed_in_sandbox",
        "blocked",
        "failed",
        "skipped",
        "escalated",
        "recovered"
      ]
    },
    "external_side_effect": {
      "const": false
    },
    "approval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "decision_id",
            "status"
          ],
          "properties": {
            "decision_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "pending",
                "approved",
                "rejected",
                "modified",
                "needs_more_evidence",
                "expired",
                "cancelled"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "integration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "name",
            "mode",
            "attempted_write",
            "target"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "enum": [
                "disabled",
                "documented",
                "sandbox",
                "read_only",
                "write_limited"
              ]
            },
            "attempted_write": {
              "type": "boolean"
            },
            "target": {
              "enum": [
                "none",
                "sandbox"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "autonomy": {
      "type": "object",
      "required": [
        "class",
        "founder_minutes"
      ],
      "properties": {
        "class": {
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3"
          ]
        },
        "founder_minutes": {
          "type": "number",
          "minimum": 0
        },
        "correction_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "recovery_of_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "compliance": {
      "type": "object",
      "required": [
        "policy_version",
        "channel",
        "method",
        "purpose",
        "recipient_ref",
        "sender_ref",
        "suppression_version",
        "policy_sha256",
        "jurisdiction",
        "recipient_time_zone",
        "recipient_local_time",
        "evaluated_at",
        "suppression_checked_at",
        "evidence_hashes",
        "rule_results",
        "failed_rule_ids",
        "reason_codes",
        "proposed_remedy",
        "approvable"
      ],
      "properties": {
        "policy_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "recipient_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sender_ref": {
          "type": [
            "string",
            "null"
